# Copiare in /etc/spendy-backup.env con permessi 600 e proprietario root.
# Non inserire questo file nel repository.

SPENDY_BACKUP_DIR=/var/backups/spendy
SPENDY_BACKUP_STATUS_FILE=/opt/spendy/backup-status/status.json
SPENDY_BACKUP_LOCK=/run/lock/spendy-backup.lock

# Chiave pubblica age usata per cifrare i backup.
# La chiave privata corrispondente va nel password manager e, per il test
# automatico, in /etc/spendy-backup/age.key con permessi 600.
SPENDY_AGE_RECIPIENT=age1...
SPENDY_AGE_IDENTITY_FILE=/etc/spendy-backup/age.key

# Destinazione rclone, ad esempio b2:SpendyBackup.
SPENDY_RCLONE_REMOTE=b2:SpendyBackup
SPENDY_DOCKER_COMPOSE="docker compose"

# Retention (default indicati).
SPENDY_BACKUP_INCREMENTAL_HOURS=48
SPENDY_BACKUP_DAILY_KEEP=7
SPENDY_BACKUP_WEEKLY_KEEP=4
SPENDY_BACKUP_MONTHLY_KEEP=12

# Alert operativi (scripts/healthcheck.py e spendy-alert@.service).
# Webhook compatibile ntfy: vuoto = solo journal, nessuna notifica esterna.
# Usa un topic privato o un'istanza ntfy self-hosted; i messaggi non devono
# contenere dati finanziari.
SPENDY_ALERT_WEBHOOK=

# Controllo del backup: allarme se l'ultimo successo è più vecchio di N minuti.
SPENDY_BACKUP_MAX_AGE_MINUTES=30

# Controllo disco dell'host.
SPENDY_DISK_PATH=/
SPENDY_DISK_MAX_PERCENT=85

# Controllo scadenza certificato TLS: vuoto = disabilitato.
# Esempio: SPENDY_DOMAIN=spendy.example.com
SPENDY_DOMAIN=
SPENDY_CERT_MIN_DAYS=14

# Percorsi extra da includere nel bundle cifrato (configurazione/certificati
# NPM, dati host). Separare con virgola o riga; devono essere assoluti.
# Esempio: SPENDY_EXTRA_BACKUP_PATHS=/var/lib/docker/volumes/npm_data/_data
SPENDY_EXTRA_BACKUP_PATHS=
