# Copiare in /etc/spendy-backup.env con permessi 600 e proprietario root.
# Non inserire questo file nel repository.

SPENDY_BACKUP_DIR=/var/backups/spendy
SPENDY_BACKUP_STATUS_FILE=/opt/spendy/backup-status/status.json
SPENDY_BACKUP_LOCK=/run/lock/spendy-backup.lock

# Chiave pubblica age usata per cifrare i backup.
# La chiave privata corrispondente va nel password manager e, per il test
# automatico, in /etc/spendy-backup/age.key con permessi 600.
SPENDY_AGE_RECIPIENT=age1...
SPENDY_AGE_IDENTITY_FILE=/etc/spendy-backup/age.key

# Destinazione rclone, ad esempio b2:SpendyBackup.
SPENDY_RCLONE_REMOTE=b2:SpendyBackup
SPENDY_DOCKER_COMPOSE="docker compose"

# Retention (default indicati).
SPENDY_BACKUP_INCREMENTAL_HOURS=48
SPENDY_BACKUP_DAILY_KEEP=7
SPENDY_BACKUP_WEEKLY_KEEP=4
SPENDY_BACKUP_MONTHLY_KEEP=12
