<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP è consentito solo dopo il controllo dell'app: host privato/Tailscale
     e conferma esplicita dell'utente (DC-102/104). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
